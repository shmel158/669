# Hyperliquid — используйте agent/API wallet, а не приватный ключ основного кошелька!
# Сгенерировать: Exchange.approve_agent() один раз с ключом мастер-кошелька,
# либо через UI: https://app.hyperliquid.xyz/API
HL_AGENT_PRIVATE_KEY=0x...
HL_ACCOUNT_ADDRESS=0xYourMainWalletAddress

# Telegram (my.telegram.org -> API Development Tools)
TG_API_ID=123456
TG_API_HASH=your_api_hash
TG_SESSION_NAME=whale_mirror_bot
# ID чата/канала с сигналами (число, можно узнать через src/telegram_listener.py --list-chats)
TG_SOURCE_CHAT_ID=-1001234567890
